RewriteEngine On
RewriteBase /

# ─── Proteger acceso directo a content (todo tipo de archivo) ───
RewriteRule ^content/(.+)$ api/content/verificar.php?ruta=$1 [QSA,L]

# ─── Redirigir rutas api/ que no sean archivos reales ───────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/Router.php [QSA,L]